# Optional: canonical site origin for SEO fallbacks before client hydration (defaults in src/config/site.js)
# Also used by Cloud Functions invite emails when synced as SITE_BASE_URL (see deploy workflow).
# VITE_SITE_URL=https://reddominoholdings.com

# Firebase App Check (web shell) — see docs/APP_CHECK_WEB.md
# VITE_USE_APP_CHECK=true
# VITE_FIREBASE_APP_CHECK_RECAPTCHA_SITE_KEY=
# VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# Optional: GitHub Pages project URL only (must match repo name, trailing slash OK)
# Custom domain at site root should keep default base '/' — do not set this.
# VITE_BASE_URL=/website-v1/

# Firebase JS SDK (Vite/React shell — e.g. Analytics). Not used by the Flutter iframe (FlutterFire).
# Copy values from Firebase Console → Project settings → Your apps → Web. CI: repository Variables VITE_FIREBASE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# Optional for access gate UX:
# - Ensure Google provider is enabled in Firebase Authentication
# - Bootstrap first admin in Firestore: admins/<uid> => { enabled: true }
# - Invite-only bootstrap target email (used for first admin claim)
VITE_BOOTSTRAP_ADMIN_EMAIL=marc77014@gmail.com

# Optional: Google Maps JavaScript API key for Flutter web embeds (index.html script tag).
# Local: set before `npm run build`. CI: repository secret GOOGLE_MAPS_WEB_API_KEY.
# GOOGLE_MAPS_WEB_API_KEY=

# Optional: Flutter web assets/.env — injected into dist/ by scripts/inject-flutter-web-env.mjs
# (never commit real values; same names as GitHub Actions secrets below).
# GOOGLE_PLACES_API_KEY=
# GOOGLE_CLOUD_VISION_API_KEY=
# GOOGLE_MAPS_API_KEY=
# HERE_API_KEY=
# HERE_APP_ID=
# ACCUWEATHER_API_KEY=
# EIA_API_KEY=
# APP_INVITE_BASE_URL=https://www.example.com/precision-pilot/
# Invite emails are sent from Firebase Functions via Gmail API OAuth secrets:
# - GMAIL_CLIENT_ID
# - GMAIL_CLIENT_SECRET
# - GMAIL_REFRESH_TOKEN
# (set in Firebase Functions secrets / GitHub Actions secrets; never in client env files)
