{
  "name": "red-domino-holdings",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/copy-spa-route-shells.mjs && node scripts/rewrite-flutter-embed-base-href.mjs && node scripts/inject-google-maps-key.mjs && node scripts/inject-flutter-web-env.mjs && node scripts/verify-flutter-embed-assets.mjs && node scripts/verify-living-bible-web-embed.mjs",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2",
    "lint:functions": "npm --prefix functions run lint",
    "test:functions": "npm --prefix functions run test",
    "install:functions": "npm --prefix functions install",
    "deploy:functions": "firebase deploy --only functions,firestore:rules",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "markdownlint-cli2": "^0.22.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.21"
  }
